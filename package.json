{
  "name": "virus-helper",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run && node --test scripts/prepare-release.test.mjs",
    "test:watch": "vitest",
    "format": "prettier --write src vite.config.ts index.html \"*.json\" \".github/workflows/*.yml\" \"src-tauri/*.json\" \"src-tauri/capabilities/*.json\"",
    "format:check": "prettier --check src vite.config.ts index.html \"*.json\" \".github/workflows/*.yml\" \"src-tauri/*.json\" \"src-tauri/capabilities/*.json\"",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^29.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.0"
  }
}
